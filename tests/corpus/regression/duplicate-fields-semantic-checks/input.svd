<device schemaVersion="1.3">
  <name>D</name>
  <version>1</version>
  <description>Duplicate fields must not hide independent errors</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <peripherals>
    <peripheral>
      <name>P</name>
      <description>Peripheral</description>
      <baseAddress>0x1000</baseAddress>
      <addressBlock><offset>0</offset><size>4</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>R</name><addressOffset>0</addressOffset>
          <fields>
            <field><name>Reserved</name><bitRange>[0:0]</bitRange></field>
            <field>
              <name>Reserved</name><bitRange>[0:0]</bitRange>
              <enumeratedValues>
                <enumeratedValue><name>TooLarge</name><value>2</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>OTHER</name><addressOffset>0</addressOffset><resetValue>0x100000000</resetValue>
          <fields><field><name>Outside</name><bitRange>[32:31]</bitRange></field></fields>
        </register>
        <register><name>OUTSIDE</name><addressOffset>4</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
