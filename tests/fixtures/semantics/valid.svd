  <resetValue>17</resetValue><resetMask>255</resetMask>
  <peripherals><peripheral><name>P</name><description>p</description><baseAddress>0x1000</baseAddress>
    <addressBlock><offset>0</offset><size>4</size><usage>registers</usage></addressBlock>
    <addressBlock><offset>8</offset><size>4</size><usage>registers</usage></addressBlock>
    <registers>
      <register><name>CTRL</name><addressOffset>0</addressOffset><fields>
        <field><name>A</name><bitOffset>0</bitOffset><bitWidth>4</bitWidth><enumeratedValues><usage>read</usage><enumeratedValue><name>OFF</name><value>0</value></enumeratedValue></enumeratedValues><enumeratedValues><usage>write</usage><enumeratedValue><name>START</name><value>0</value></enumeratedValue></enumeratedValues></field>
